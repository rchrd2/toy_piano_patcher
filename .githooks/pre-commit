#!/bin/sh
# Bump the patcher version on each commit and write it into the files that show it.
# If VERSION is already staged in this commit (edited by hand), its number is used as it is.
# Turn on once per clone with: git config core.hooksPath .githooks
set -eu

cd "$(git rev-parse --show-toplevel)"

FILES='VERSION README.md toy_piano_patcher.py'

# Adding a file stages all of it, so refuse if any has changes that aren't staged.
for file in $FILES; do
    if [ -e "$file" ] && ! git diff --quiet -- "$file"; then
        echo "pre-commit: $file has unstaged changes. Stage or stash them, then commit again." >&2
        exit 1
    fi
done

current=$(tr -d ' \r\n' < VERSION)
if ! printf '%s\n' "$current" | grep -Eq '^[0-9]+$'; then
    echo "pre-commit: VERSION should be a whole number such as 3, found '$current'." >&2
    exit 1
fi

if git diff --cached --name-only -- VERSION | grep -qx VERSION; then
    version=$current
else
    version=$((current + 1))
    printf '%s\n' "$version" > VERSION
fi

# -i.bak works with both the macOS and GNU versions of sed; the backups are removed one by one.
sed -i.bak -E "s/Patcher version v[0-9]+/Patcher version v$version/g" README.md
sed -i.bak -E "s/^PATCHER_VERSION = '[^']*'/PATCHER_VERSION = '$version'/" toy_piano_patcher.py
rm -f README.md.bak toy_piano_patcher.py.bak

if ! grep -q "Patcher version v$version\$" README.md || ! grep -q "^PATCHER_VERSION = '$version'" toy_piano_patcher.py; then
    echo "pre-commit: could not write version $version into README.md and toy_piano_patcher.py." >&2
    exit 1
fi

git add $FILES
echo "pre-commit: patcher version $version"
